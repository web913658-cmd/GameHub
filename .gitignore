data/
*.log

# ---- 开发调试产物 ----
# 截图、临时测试脚本、浏览器自动化会话
shots/
.playwright-cli/
build/_verify_*.py
build/_t*.jpg
build/_duck.bin

# ---- 编辑器 / 系统 ----
